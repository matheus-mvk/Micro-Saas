  @@index([tenantId, simulationId, totalPrice])
  @@index([tenantId, carrierId, carrierServiceId, createdAt], map: "freight_options_carrier_service_idx")
  @@index([tenantId, selected, createdAt], map: "freight_options_selected_period_idx")
  @@map("freight_simulation_options")
}

