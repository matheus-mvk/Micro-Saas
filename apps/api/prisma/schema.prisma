generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum AuditAction {
  LOGIN
  LOGOUT
  AUTH_FAILURE
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  CUSTOMER_CHANGED
  CARRIER_CHANGED
  IMPORT_CREATED
  ADMIN_OPERATION
}

enum FreightSimulationStatus {
  DRAFT
  QUEUED
  CALCULATED
  FAILED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(160)
  document  String?  @db.VarChar(32)
  slug      String   @unique @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  auditLogs           AuditLog[]
  branches            Branch[]
  carriers            Carrier[]
  customers           Customer[]
  freightSimulations  FreightSimulation[]
  importJobs          ImportJob[]
  refreshTokens       RefreshToken[]
  users               User[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  name      String   @db.VarChar(120)
  code      String   @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  tenantId     String     @map("tenant_id") @db.Char(36)
  branchId     String?    @map("branch_id") @db.Char(36)
  name         String     @db.VarChar(140)
  email        String     @db.VarChar(180)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  auditLogs     AuditLog[]     @relation("AuditActor")
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  importJobs    ImportJob[]
  refreshTokens RefreshToken[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  tenantId   String    @map("tenant_id") @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  familyId   String    @map("family_id") @db.Char(36)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ipHash     String?   @map("ip_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  rotatedAt  DateTime? @map("rotated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tokenHash])
  @@index([tenantId, userId, revokedAt])
  @@map("refresh_tokens")
}

model Customer {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  name      String   @db.VarChar(160)
  document  String?  @db.VarChar(32)
  email     String?  @db.VarChar(180)
  phone     String?  @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  freightSimulations FreightSimulation[]
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, document])
  @@index([tenantId, active, name])
  @@map("customers")
}

model Carrier {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  name      String   @db.VarChar(160)
  document  String?  @db.VarChar(32)
  code      String?  @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  freightSimulations FreightSimulation[]
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, document])
  @@unique([tenantId, code])
  @@index([tenantId, active, name])
  @@map("carriers")
}

model FreightSimulation {
  id                  String                  @id @default(uuid()) @db.Char(36)
  tenantId            String                  @map("tenant_id") @db.Char(36)
  customerId          String?                 @map("customer_id") @db.Char(36)
  carrierId           String?                 @map("carrier_id") @db.Char(36)
  originPostalCode    String                  @map("origin_postal_code") @db.VarChar(16)
  destinationPostalCode String                @map("destination_postal_code") @db.VarChar(16)
  realWeightKg        Decimal                 @map("real_weight_kg") @db.Decimal(10, 3)
  cubicWeightKg       Decimal?                @map("cubic_weight_kg") @db.Decimal(10, 3)
  lengthCm            Decimal?                @map("length_cm") @db.Decimal(10, 2)
  widthCm             Decimal?                @map("width_cm") @db.Decimal(10, 2)
  heightCm            Decimal?                @map("height_cm") @db.Decimal(10, 2)
  cargoValue          Decimal?                @map("cargo_value") @db.Decimal(12, 2)
  distanceKm          Decimal?                @map("distance_km") @db.Decimal(10, 2)
  estimatedPrice      Decimal?                @map("estimated_price") @db.Decimal(12, 2)
  estimatedDeadlineDays Int?                  @map("estimated_deadline_days")
  status              FreightSimulationStatus @default(DRAFT)
  metadata            Json?
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  carrier  Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, originPostalCode, destinationPostalCode])
  @@map("freight_simulations")
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Char(36)
  tenantId    String       @map("tenant_id") @db.Char(36)
  createdById String       @map("created_by_id") @db.Char(36)
  filename    String       @db.VarChar(255)
  fileType    String       @map("file_type") @db.VarChar(16)
  status      ImportStatus @default(PENDING)
  totalRows   Int          @default(0) @map("total_rows")
  processedRows Int        @default(0) @map("processed_rows")
  errorSummary Json?       @map("error_summary")
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@map("import_jobs")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Char(36)
  tenantId    String?     @map("tenant_id") @db.Char(36)
  actorId     String?     @map("actor_id") @db.Char(36)
  action      AuditAction
  entityType  String?     @map("entity_type") @db.VarChar(80)
  entityId    String?     @map("entity_id") @db.Char(36)
  requestId   String?     @map("request_id") @db.VarChar(64)
  ipHash      String?     @map("ip_hash") @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  actor User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
