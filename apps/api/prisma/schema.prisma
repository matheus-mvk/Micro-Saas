model FreightSimulationOption {
  id                  String    @id @default(uuid()) @db.Char(36)
  tenantId            String    @map("tenant_id") @db.Char(36)
  simulationId        String    @map("simulation_id") @db.Char(36)
  carrierId           String    @map("carrier_id") @db.Char(36)
  carrierServiceId    String    @map("carrier_service_id") @db.Char(36)
  rateTableId         String    @map("rate_table_id") @db.Char(36)
  rateRangeId         String    @map("rate_range_id") @db.Char(36)
  carrierName         String    @map("carrier_name") @db.VarChar(160)
  serviceName         String    @map("service_name") @db.VarChar(140)
  serviceCode         String    @map("service_code") @db.VarChar(40)
  rateTableVersion    Int       @map("rate_table_version")
  currency            String    @default("BRL") @db.VarChar(3)
  realWeightKg        Decimal   @map("real_weight_kg") @db.Decimal(10, 3)
  cubicWeightKg       Decimal   @map("cubic_weight_kg") @db.Decimal(10, 3)
  chargeableWeightKg  Decimal   @map("chargeable_weight_kg") @db.Decimal(10, 3)
  distanceKm          Decimal?  @map("distance_km") @db.Decimal(10, 2)
  deadlineDays        Int       @map("deadline_days")
  estimatedDeliveryAt DateTime  @map("estimated_delivery_at") @db.DateTime(3)
  totalPrice          Decimal   @map("total_price") @db.Decimal(12, 2)
  cheapest            Boolean   @default(false)
  fastest             Boolean   @default(false)
  selected            Boolean   @default(false)
