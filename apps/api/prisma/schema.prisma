model Shipment {
  id                  String         @id @default(uuid()) @db.Char(36)
  tenantId            String         @map("tenant_id") @db.Char(36)
  simulationId        String         @unique @map("simulation_id") @db.Char(36)
  selectedOptionId    String         @unique @map("selected_option_id") @db.Char(36)
  customerId          String?        @map("customer_id") @db.Char(36)
  branchId            String?        @map("branch_id") @db.Char(36)
  carrierId           String         @map("carrier_id") @db.Char(36)
  carrierServiceId    String         @map("carrier_service_id") @db.Char(36)
  createdById         String?        @map("created_by_id") @db.Char(36)
  trackingCode        String         @map("tracking_code") @db.VarChar(80)
  externalReference   String?        @map("external_reference") @db.VarChar(80)
  realWeightKg        Decimal        @map("real_weight_kg") @db.Decimal(10, 3)
  chargeableWeightKg  Decimal        @map("chargeable_weight_kg") @db.Decimal(10, 3)
  cargoValue          Decimal?       @map("cargo_value") @db.Decimal(12, 2)
  freightValue        Decimal        @map("freight_value") @db.Decimal(12, 2)
  estimatedDeliveryAt DateTime       @map("estimated_delivery_at") @db.DateTime(3)
  deliveredAt         DateTime?      @map("delivered_at") @db.DateTime(3)
  status              ShipmentStatus @default(CREATED)
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  addresses ShipmentAddress[]
  packages  ShipmentPackage[]
  trackingEvents TrackingEvent[]

  @@unique([tenantId, trackingCode])
  @@index([tenantId, status, estimatedDeliveryAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, carrierId, createdAt])
  @@index([tenantId, branchId, createdAt], map: "shipments_branch_period_idx")
  @@index([tenantId, carrierServiceId, createdAt], map: "shipments_service_period_idx")
  @@map("shipments")
}

model TrackingEvent {
  id           String            @id @default(uuid()) @db.Char(36)
  tenantId     String            @map("tenant_id") @db.Char(36)
  shipmentId   String            @map("shipment_id") @db.Char(36)
  createdById  String?           @map("created_by_id") @db.Char(36)
  eventType    TrackingEventType @map("event_type")
  status       ShipmentStatus?
  description  String?           @db.VarChar(500)
  occurredAt   DateTime          @map("occurred_at") @db.DateTime(3)
  receivedAt   DateTime          @default(now()) @map("received_at") @db.DateTime(3)
  location     String?           @db.VarChar(180)
  externalCode String?           @map("external_code") @db.VarChar(120)
  metadata     Json?
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(180)
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, shipmentId, idempotencyKey])
  @@index([tenantId, shipmentId, occurredAt])
  @@index([tenantId, eventType, createdAt])
  @@map("tracking_events")
}

