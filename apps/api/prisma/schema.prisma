  errorMessage      String?         @map("error_message") @db.VarChar(500)
  createdResourceId String?         @map("created_resource_id") @db.Char(36)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, importJobId, rowNumber])
  @@index([tenantId, importJobId, status])
  @@map("import_row_results")
}

model Insight {
  id               String          @id @default(uuid()) @db.Char(36)
  tenantId         String          @map("tenant_id") @db.Char(36)
  dedupeKey        String          @map("dedupe_key") @db.VarChar(180)
  type             String          @db.VarChar(80)
  category         InsightCategory
  severity         InsightSeverity
  title            String          @db.VarChar(180)
  description      String          @db.VarChar(700)
  evidence         Json
  metricValue      Decimal?        @map("metric_value") @db.Decimal(14, 4)
  comparisonValue  Decimal?        @map("comparison_value") @db.Decimal(14, 4)
  percentageChange Decimal?        @map("percentage_change") @db.Decimal(9, 4)
  periodStart      DateTime        @map("period_start") @db.DateTime(3)
  periodEnd        DateTime        @map("period_end") @db.DateTime(3)
  resourceType     String?         @map("resource_type") @db.VarChar(80)
  resourceId       String?         @map("resource_id") @db.Char(36)
  actionUrl        String?         @map("action_url") @db.VarChar(255)
  status           InsightStatus   @default(NEW)
  generatedAt      DateTime        @default(now()) @map("generated_at") @db.DateTime(3)
  readAt           DateTime?       @map("read_at") @db.DateTime(3)
  dismissedAt      DateTime?       @map("dismissed_at") @db.DateTime(3)
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, generatedAt])
  @@index([tenantId, category, severity, generatedAt])
  @@index([tenantId, status, category, severity, periodStart], map: "insights_filter_idx")
  @@index([tenantId, periodStart, periodEnd])
  @@map("insights")
}

